new file mode 100644
index 0000000..0d7e548
--- /dev/null
+++ b/recovery/root/init.recovery.bootctl.rc
@@ -0,0 +1,12 @@
+# Keep the stock AIDL BootControl implementation from the platform ramdisk.
+# The fallback HIDL implementation uses an obsolete UFS boot-region ioctl on
+# rodin and can make bootctl report a failed slot change. The stock service
+# requires the newer libc++ abort symbol.
+service vendor.boot-default /system/bin/hw/android.hardware.boot-service.mtk_recovery
+    class early_hal
+    user root
+    group root
+    setenv LD_LIBRARY_PATH /system/lib64:/vendor/lib64
+    setenv LD_PRELOAD /system/lib64/librodin_libcxx_compat.so
+    seclabel u:r:hal_bootctl_default:s0
+    interface aidl android.hardware.boot.IBootControl/default
